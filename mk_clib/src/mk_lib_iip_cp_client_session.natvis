<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="mk_lib_iip_cp_client_session_task_s">
		<DisplayString>{{ session id 0x{m_session.m_state.m_id.m_elements[0].m_elements[0],xb} }}</DisplayString>
	</Type>
	<Type Name="mk_lib_iip_cp_client_session_tasks_s">
		<DisplayString>{{ size = {m_size} capacity = {m_capacity} }}</DisplayString>
		<Expand>
			<ArrayItems>
				<Size>m_size</Size>
				<ValuePointer>m_buffer</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	<Type Name="mk_lib_iip_cp_client_session_lookups_host_name_s">
		<DisplayString>{{ size = {m_write - m_read} capacity = {m_capacity} }}</DisplayString>
		<Expand>
			<Item Name="[size]">m_write - m_read</Item>
			<Item Name="[capacity]">m_capacity</Item>
			<IndexListItems>
				<Size>m_write - m_read</Size>
				<ValueNode>m_buffer[(m_read + $i) % m_capacity]</ValueNode>
			</IndexListItems>
		</Expand>
	</Type>
</AutoVisualizer>
